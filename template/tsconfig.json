{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // 运行时是 QuickJS（无 DOM）：标准库按引擎能力取 ES2024（quickwin 包自己用 ES2025），
    // 刻意不开 DOM —— 否则 DOM 的 TextDecoder/TextEncoder 会撞包内 polyfill 的同名全局声明。
    // build.ts 也不在 include 里：它是 Node 侧脚本，需要 @types/node 才类型完整。
    "lib": ["es2024"],
    "types": []
  },
  "include": [
    "src",
    "node_modules/quickwin/quickwin.d.ts"
  ]
}
